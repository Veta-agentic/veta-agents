# =============================================================================
# terraform.tfvars.example
# Copy to terraform.tfvars and fill in the values.
# =============================================================================

# Required — Azure subscription to deploy into
subscription_id = "00000000-0000-0000-0000-000000000000"

# Project settings
project_name = "ghbot"
environment  = "dev"     # dev | staging | prod
location     = "westus2"

# OpenAI / Cognitive Services
openai_location         = "eastus"
openai_api_version      = "2025-01-01-preview"
gpt_model_version       = "2024-11-20"
embedding_model_version = "1"

# Sizing
app_service_sku = "P0v3"
acr_sku         = "Basic"

# Security — keep false in production; use managed identity for ACR pull
acr_admin_enabled = false

# Additional tags (optional)
extra_tags = {
  CostCenter = "Engineering"
}
